{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "export_layout command",
  "type": "object",
  "required": ["action", "params"],
  "additionalProperties": false,
  "properties": {
    "action": { "const": "export_layout" },
    "params": {
      "type": "object",
      "required": ["layout_name", "format", "path"],
      "additionalProperties": false,
      "properties": {
        "layout_name": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "enum": ["pdf", "png"] },
        "path": { "type": "string", "minLength": 1 },
        "confirm_overwrite": { "type": "boolean", "default": false }
      }
    }
  }
}
